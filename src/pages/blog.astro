---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', {eager: true}));
---

<BaseLayout pageTitle="My Blog">
    <p>This is sample blog post for the Astro site tutorial</p>

        <p>So far I have liked Astro and its approach to web dev</p>

        <ul>
            {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
        </ul>
</BaseLayout>
